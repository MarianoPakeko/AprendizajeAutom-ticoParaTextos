# 2: ADVANCED MODEL EVALUATION FRAMEWORK
# ==============================================================================
def evaluate_model(model, train_features, train_target, test_features, test_target):
    """
    Executes a comprehensive evaluation pipeline displaying F1-Score, 
    ROC AUC, and Precision-Recall Curves across train and test sets.
    """
    eval_stats = {}
    fig, axs = plt.subplots(1, 3, figsize=(20, 6))

    for split_type, features, target in (('train', train_features, train_target), ('test', test_features, test_target)):
        eval_stats[split_type] = {}

        # Model Inferences
        pred_target = model.predict(features)
        pred_proba = model.predict_proba(features)[:, 1]

        # F1 Dynamic Threshold Optimization
        f1_thresholds = np.arange(0, 1.01, 0.05)
        f1_scores = [metrics.f1_score(target, pred_proba >= threshold) for threshold in f1_thresholds]

        # ROC Curve Calculations
        fpr, tpr, roc_thresholds = metrics.roc_curve(target, pred_proba)
        roc_auc = metrics.roc_auc_score(target, pred_proba)
        eval_stats[split_type]['ROC AUC'] = roc_auc

        # Precision-Recall Curve Calculations
        precision, recall, pr_thresholds = metrics.precision_recall_curve(target, pred_proba)
        aps = metrics.average_precision_score(target, pred_proba)
        eval_stats[split_type]['APS'] = aps

        color = 'blue' if split_type == 'train' else 'green'

        # Subplot 1: F1 Optimization Curve
        ax = axs[0]
        max_f1_idx = np.argmax(f1_scores)
        ax.plot(f1_thresholds, f1_scores, color=color, label=f'{split_type}, max={f1_scores[max_f1_idx]:.2f} @ {f1_thresholds[max_f1_idx]:.2f}')
        for threshold in (0.2, 0.4, 0.5, 0.6, 0.8):
            closest_idx = np.argmin(np.abs(f1_thresholds - threshold))
            marker_color = 'orange' if threshold != 0.5 else 'red'
            ax.plot(f1_thresholds[closest_idx], f1_scores[closest_idx], color=marker_color, marker='X', markersize=7)
        ax.set_xlim([-0.02, 1.02]); ax.set_ylim([-0.02, 1.02])
        ax.set_xlabel('Threshold'); ax.set_ylabel('F1-Score'); ax.set_title('F1 Score Optimization')
        ax.legend(loc='lower center')

        # Subplot 2: Receiver Operating Characteristic (ROC)
        ax = axs[1]
        ax.plot(fpr, tpr, color=color, label=f'{split_type}, ROC AUC={roc_auc:.2f}')
        for threshold in (0.2, 0.4, 0.5, 0.6, 0.8):
            closest_idx = np.argmin(np.abs(roc_thresholds - threshold))
            marker_color = 'orange' if threshold != 0.5 else 'red'
            ax.plot(fpr[closest_idx], tpr[closest_idx], color=marker_color, marker='X', markersize=7)
        ax.plot([0, 1], [0, 1], color='grey', linestyle='--')
        ax.set_xlim([-0.02, 1.02]); ax.set_ylim([-0.02, 1.02])
        ax.set_xlabel('FPR'); ax.set_ylabel('TPR'); ax.set_title('ROC Curve')
        ax.legend(loc='lower center')

        # Subplot 3: Precision-Recall Curve (PRC)
        ax = axs[2]
        ax.plot(recall, precision, color=color, label=f'{split_type}, AP={aps:.2f}')
        for threshold in (0.2, 0.4, 0.5, 0.6, 0.8):
            closest_idx = np.argmin(np.abs(pr_thresholds - threshold))
            marker_color = 'orange' if threshold != 0.5 else 'red'
            ax.plot(recall[closest_idx], precision[closest_idx], color=marker_color, marker='X', markersize=7)
        ax.set_xlim([-0.02, 1.02]); ax.set_ylim([-0.02, 1.02])
        ax.set_xlabel('Recall'); ax.set_ylabel('Precision'); ax.set_title('Precision-Recall Curve')
        ax.legend(loc='lower center')

        eval_stats[split_type]['Accuracy'] = metrics.accuracy_score(target, pred_target)
        eval_stats[split_type]['F1'] = metrics.f1_score(target, pred_target)

    df_eval_stats = pd.DataFrame(eval_stats).round(2)
    df_eval_stats = df_eval_stats.reindex(index=('Accuracy', 'F1', 'APS', 'ROC AUC'))
    print(df_eval_stats)
    return df_eval_stats

